# FlowTiger Web — ortam değişkenleri (ÖRNEK)
#
# cp .env.example .env.local
#
# Vite'ta VITE_ önekli her değişken TARAYICI PAKETİNE GÖMÜLÜR.
# Buraya sır yazmayın: API anahtarı, token, parola asla.
# API adresi sır değildir; kullanıcı zaten ağ sekmesinde görür.

# Backend API kökü. Sondaki /api/v1 dahil.
VITE_API_BASE_URL=http://localhost:8000/api/v1
