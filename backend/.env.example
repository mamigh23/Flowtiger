###############################################################################
# FlowTiger — backend ortam değişkenleri (ÖRNEK)
#
# Bu dosya repoya girer ve GERÇEK SIR İÇERMEZ. Kurulum:
#
#     cp .env.example .env
#     php artisan key:generate
#
# Faz 10 notu: bu dosya daha önce Laravel'in stok içeriğindeydi ve
# DB_CONNECTION=sqlite diyordu. FlowTiger yalnızca PostgreSQL üzerinde
# çalışır (test suite'i bunu bir bariyerle zorlar), dolayısıyla stok
# içerik yeni bir geliştiriciyi doğrudan hatalı kuruluma götürüyordu.
###############################################################################

APP_NAME=FlowTiger
APP_ENV=local

# php artisan key:generate ile üretilir. ASLA repoya yazılmaz.
APP_KEY=

# PRODUCTION'DA MUTLAKA false.
# true bırakılırsa hata yanıtları stack trace, dosya yolu, SQL ve
# ortam değişkeni sızdırır.
APP_DEBUG=true

APP_URL=http://localhost
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

# Production'da 12 (varsayılan) bırakılmalı. Test ortamı phpunit.xml
# içinden 4'e çeker; bu yalnızca test hızı içindir.
BCRYPT_ROUNDS=12

###############################################################################
# LOG
#
# Production'da LOG_LEVEL=debug KULLANMAYIN: debug seviyesi istek
# gövdelerini ve sorgu ayrıntılarını loga taşıyabilir.
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# VERİTABANI — yalnızca PostgreSQL
#
# Geliştirme:  flowtiger_db
# Test:        flowtiger_test  (phpunit.xml içinde sabitlenmiştir)
#
# Test suite'i, yanlış yapılandırılmış bir .env yüzünden geliştirme ya da
# production veritabanını silmesin diye flowtiger_test dışındaki hiçbir
# veritabanında çalışmaz (tests/TestCase.php).
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flowtiger_db
DB_USERNAME=flowtiger_app
DB_PASSWORD=

###############################################################################
# SESSION / CACHE / QUEUE
#
# API token tabanlı çalıştığı için session pratikte kullanılmıyor.
# Cache, rate limiter sayaçlarını tutar — production'da redis önerilir.
# Queue şu an kullanılmıyor; mail senkron gönderiliyor (bkz. docs/PRODUCTION.md).
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###############################################################################
# MAIL
#
# Davet, e-posta doğrulama ve parola sıfırlama bağlantıları buradan gider.
# 'log' sürücüsünde bağlantılar storage/logs içine yazılır — PRODUCTION'DA
# KULLANMAYIN: token'lar log dosyasına düşer.
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@flowtiger.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# CORS
#
# Virgülle ayrılmış TAM origin listesi. Boş bırakılırsa hiçbir tarayıcı
# cross-origin isteğine izin verilmez (mobil/sunucu istemcileri etkilenmez).
# '*' PRODUCTION'DA ASLA KULLANILMAZ.
#
# Örnek: CORS_ALLOWED_ORIGINS=https://app.flowtiger.com
###############################################################################
CORS_ALLOWED_ORIGINS=

###############################################################################
# FLOWTIGER — uygulamaya özgü
###############################################################################

# Davet bağlantısının geçerlilik süresi (gün).
FLOWTIGER_INVITATION_EXPIRY_DAYS=7

# Parola sıfırlama bağlantısının şablonu. {token} ve {email} yer
# tutucuları gönderim anında doldurulur. Frontend'in reset sayfasına
# işaret etmelidir.
FLOWTIGER_PASSWORD_RESET_URL="${APP_URL}/password/reset/{token}?email={email}"
