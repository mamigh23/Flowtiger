# FlowTiger — TEST ORTAMI ŞABLONU
#
# Kullanım:
#   cp .env.testing.example .env.testing
#   php artisan key:generate --env=testing
#   (DB_PASSWORD değerini .env dosyasındakiyle aynı yap)
#
# BU DOSYA OPSİYONELDİR.
#   - `php artisan test` için gerekli DEĞİLDİR: phpunit.xml zaten
#     DB_DATABASE=flowtiger_test değerini zorlar.
#   - `php artisan migrate --env=testing` gibi CLI komutlarını test
#     veritabanına yöneltmek için GEREKLİDİR.
#
# UYARI: `.env.testing` yokken `--env=testing` bayrağı kullanılırsa
# Laravel `.env` dosyasına geri düşer ve komut GELİŞTİRME veritabanında
# çalışır. Bu dosyayı oluşturmadan `--env=testing` kullanma.
#
# DİKKAT: DB_DATABASE değeri asla flowtiger_db (geliştirme) olmamalıdır.
# Test suite'i yıkıcıdır; tests/TestCase.php içindeki bariyer bunu
# ayrıca engeller, fakat ilk savunma hattı burasıdır.

APP_NAME=FlowTiger
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flowtiger_test
DB_USERNAME=flowtiger_app
DB_PASSWORD=

BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null
